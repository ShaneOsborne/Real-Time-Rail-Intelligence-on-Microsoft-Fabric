// Lab 06 - step 2: parsing functions + update policies.
// Batched TRUST payloads (JSON arrays) from either source are expanded and routed by header.msg_type:
//   0001 activation, 0002 cancellation, 0003 movement, 0004-0008 -> TrustOtherEvents.
// RdmTrustRaw holds whatever RDM Kafka product you connect (it is unwrapped by UnwrapRdm()):
//   NWR Train Movements (TRUST)  -> Trust* tables;  Darwin Push Port ("PushPort" topics) -> DarwinLocations.
// Update policies only process data ingested AFTER they exist. To back-fill, see fabric/kql/08_backfill.kql.
// NOTE: TRUST timestamps are epoch milliseconds. The Open Rail Data wiki notes they reflect UK local
// time in some fields - check https://wiki.openraildata.com/index.php/Train_Movements before relying on
// sub-hour accuracy around BST changes.
.execute database script with (ContinueOnErrors=false) <|
.create-or-alter function with (folder="parsing", docstring="Expand NROD TRUST events from RawFeed") ExpandTrustNrod() {
    RawFeed
    | where feed == "trust"
    | extend items = iff(gettype(payload) == "array", payload, pack_array(payload))
    | mv-expand item = items
    | project received_utc, source, item
}

.create-or-alter function with (folder="parsing", docstring="Unwrap the RDM pub/sub envelope. RDM Kafka messages are an ActiveMQ message serialised as JSON (destination, messageID, bytes/text, properties); the real feed JSON is a string in 'bytes' (or 'text'). Un-wrapped payloads pass through unchanged.") UnwrapRdm() {
    RdmTrustRaw
    | extend received_utc = ingestion_time()
    | extend rdm_destination = tostring(payload.destination.name)
    | extend raw_body = case(isnotempty(tostring(payload.bytes)), tostring(payload.bytes),
                             isnotempty(tostring(payload.text)), tostring(payload.text),
                             "")
    | extend b1 = iff(isempty(raw_body), payload, parse_json(raw_body))
    | extend b2 = iff(gettype(b1) == "string", parse_json(tostring(b1)), b1)   // tolerate double-encoded JSON
    | extend body = iff(gettype(b2) == "string", parse_json(replace_string(tostring(b2), @'\"', '"')), b2)   // and literal \" escapes
    | project received_utc, rdm_destination, body
}

.create-or-alter function with (folder="parsing", docstring="Expand RDM TRUST (NWR Train Movements) events from RdmTrustRaw; Darwin Push Port messages are excluded") ExpandTrustRdm() {
    UnwrapRdm()
    | where rdm_destination !has "PushPort" and isnull(body.uR) and isnull(body.sR)
    | extend items = iff(gettype(body) == "array", body, pack_array(body))
    | mv-expand item = items
    | project received_utc, source = "rdm", item
}

.create-or-alter function with (folder="parsing", docstring="'HH:MM' or 'HH:MM:SS' -> minutes after midnight (null if empty)") HhmmToMinutes(t:string) {
    iff(strlen(t) < 5, int(null), toint(substring(t, 0, 2)) * 60 + toint(substring(t, 3, 2)))
}

.create-or-alter function with (folder="parsing", docstring="Minutes late (+) / early (-) between two Darwin HH:MM times, allowing for midnight") DarwinDelay(planned:string, actual:string) {
    let p = HhmmToMinutes(planned);
    let a = HhmmToMinutes(actual);
    let d = a - p;
    iff(isnull(p) or isnull(a), int(null), toint(iff(d < -720, d + 1440, iff(d > 720, d - 1440, d))))
}

.create-or-alter function with (folder="parsing", docstring="Darwin Push Port uR/sR TS (train status) -> one row per Location. Times are UK local HH:MM on the schedule start date (ssd).") ParseDarwinLocations() {
    UnwrapRdm()
    | extend r = iff(isnotnull(body.uR), body.uR, body.sR)
    | where isnotnull(r) and isnotnull(r.TS)
    | extend msg_ts = todatetime(tostring(body.ts)), update_origin = tostring(r.updateOrigin)
    | extend tss = iff(gettype(r.TS) == "array", r.TS, pack_array(r.TS))
    | mv-expand ts = tss
    | where isnotnull(ts.Location)
    | extend locs = iff(gettype(ts.Location) == "array", ts.Location, pack_array(ts.Location))
    | mv-expand loc = locs
    | extend plat = loc.plat
    // <plat platsrc="M" conf="true">1</plat> arrives as {"platsrc":"M","conf":"true","":"1"}; a plain platform is a string
    | extend platform = iff(gettype(plat) == "string", tostring(plat), extract(@'"":"([^"]*)"', 1, tostring(plat)))
    | extend pta = tostring(loc.pta), ptd = tostring(loc.ptd),
             arr_at = tostring(loc.arr.at), arr_et = tostring(loc.arr.et),
             dep_at = tostring(loc.dep.at), dep_et = tostring(loc.dep.et),
             pass_at = tostring(loc["pass"].at), pass_et = tostring(loc["pass"].et)
    | project
        msg_ts,
        update_origin,
        rid = tostring(ts.rid),
        uid = tostring(ts.uid),
        ssd = todatetime(tostring(ts.ssd)),
        tiploc = tostring(loc.tpl),
        wta = tostring(loc.wta),
        wtd = tostring(loc.wtd),
        wtp = tostring(loc.wtp),
        pta,
        ptd,
        arr_at,
        arr_et,
        dep_at,
        dep_et,
        pass_at,
        pass_et,
        arr_delay_minutes = toint(DarwinDelay(pta, iff(isnotempty(arr_at), arr_at, arr_et))),
        dep_delay_minutes = toint(DarwinDelay(ptd, iff(isnotempty(dep_at), dep_at, dep_et))),
        platform,
        platform_confirmed = tobool(tostring(plat.conf)),
        platform_source = tostring(plat.platsrc),
        source = "rdm-darwin",
        received_utc
}

.create-or-alter function with (folder="parsing", docstring="Epoch-ms string to datetime (null-safe)") EpochMs(v:dynamic) {
    iff(isempty(tostring(v)), datetime(null), unixtime_milliseconds_todatetime(tolong(v)))
}

.create-or-alter function with (folder="parsing", docstring="TRUST 0003 movement") ParseMovements(T:(received_utc:datetime, source:string, item:dynamic)) {
    T
    | where tostring(item.header.msg_type) == "0003"
    | extend b = item.body
    | extend vs = tostring(b.variation_status), tv = toint(b.timetable_variation)
    | project
        event_time = EpochMs(b.actual_timestamp),
        planned_time = EpochMs(b.planned_timestamp),
        gbtt_time = EpochMs(b.gbtt_timestamp),
        train_id = tostring(b.train_id),
        train_service_code = tostring(b.train_service_code),
        toc_id = tostring(b.toc_id),
        event_type = tostring(b.event_type),
        planned_event_type = tostring(b.planned_event_type),
        loc_stanox = tostring(b.loc_stanox),
        next_report_stanox = tostring(b.next_report_stanox),
        platform = trim(@"\s+", tostring(b.platform)),
        line_ind = tostring(b.line_ind),
        variation_status = vs,
        timetable_variation = tv,
        delay_minutes = toint(case(vs == "LATE", tv, vs == "EARLY", -tv, 0)),
        train_terminated = tobool(b.train_terminated),
        correction_ind = tobool(b.correction_ind),
        offroute_ind = tobool(b.offroute_ind),
        direction_ind = tostring(b.direction_ind),
        event_source = tostring(b.event_source),
        source,
        received_utc
}

.create-or-alter function with (folder="parsing", docstring="TRUST 0001 activation") ParseActivations(T:(received_utc:datetime, source:string, item:dynamic)) {
    T
    | where tostring(item.header.msg_type) == "0001"
    | extend b = item.body
    | project
        creation_time = EpochMs(b.creation_timestamp),
        origin_dep_time = EpochMs(b.origin_dep_timestamp),
        train_id = tostring(b.train_id),
        train_uid = tostring(b.train_uid),
        train_service_code = tostring(b.train_service_code),
        toc_id = tostring(b.toc_id),
        sched_origin_stanox = tostring(b.sched_origin_stanox),
        schedule_type = tostring(b.schedule_type),
        schedule_source = tostring(b.schedule_source),
        schedule_wtt_id = tostring(b.schedule_wtt_id),
        schedule_start_date = tostring(b.schedule_start_date),
        schedule_end_date = tostring(b.schedule_end_date),
        train_call_type = tostring(b.train_call_type),
        source,
        received_utc
}

.create-or-alter function with (folder="parsing", docstring="TRUST 0002 cancellation") ParseCancellations(T:(received_utc:datetime, source:string, item:dynamic)) {
    T
    | where tostring(item.header.msg_type) == "0002"
    | extend b = item.body
    | project
        canx_time = EpochMs(b.canx_timestamp),
        dep_time = EpochMs(b.dep_timestamp),
        train_id = tostring(b.train_id),
        train_service_code = tostring(b.train_service_code),
        toc_id = tostring(b.toc_id),
        loc_stanox = tostring(b.loc_stanox),
        orig_loc_stanox = tostring(b.orig_loc_stanox),
        canx_reason_code = tostring(b.canx_reason_code),
        canx_type = tostring(b.canx_type),
        source,
        received_utc
}

.create-or-alter function with (folder="parsing", docstring="TRUST 0004-0008") ParseOtherTrust(T:(received_utc:datetime, source:string, item:dynamic)) {
    T
    | extend mt = tostring(item.header.msg_type)
    | where mt in ("0004", "0005", "0006", "0007", "0008")
    | project
        msg_type = mt,
        msg_time = EpochMs(item.header.msg_queue_timestamp),
        train_id = tostring(item.body.train_id),
        toc_id = tostring(item.body.toc_id),
        body = item.body,
        source,
        received_utc
}

.create-or-alter function with (folder="parsing", docstring="TD C-class/S-class messages") ParseTd() {
    RawFeed
    | where feed == "td"
    | extend k = tostring(bag_keys(payload)[0])
    | extend m = payload[k]
    | project
        event_time = EpochMs(m.['time']),
        msg_type = tostring(m.msg_type),
        area_id = tostring(m.area_id),
        from_berth = tostring(m.from),
        to_berth = tostring(m.['to']),
        descr = tostring(m.descr),
        received_utc
}

.create-or-alter function with (folder="parsing", docstring="RTPPM national page (verify field names against the RTPPM wiki page)") ParseRtppm() {
    RawFeed
    | where feed == "rtppm"
    | extend d = payload.RTPPMDataMsgV1.RTPPMData
    | extend n = d.NationalPage.NationalPPM
    | project
        snapshot_time = EpochMs(d.snapshotTStamp),
        total = toint(n.Total),
        on_time = toint(n.OnTime),
        late = toint(n.Late),
        cancel_very_late = toint(n.CancelVeryLate),
        ppm = toreal(n.PPM.text),
        rag = tostring(n.PPM.rag),
        received_utc
}

.alter table TrustMovements policy update @'[{"IsEnabled":true,"Source":"RawFeed","Query":"ParseMovements(ExpandTrustNrod())","IsTransactional":false,"PropagateIngestionProperties":false},{"IsEnabled":true,"Source":"RdmTrustRaw","Query":"ParseMovements(ExpandTrustRdm())","IsTransactional":false,"PropagateIngestionProperties":false}]'

.alter table TrustActivations policy update @'[{"IsEnabled":true,"Source":"RawFeed","Query":"ParseActivations(ExpandTrustNrod())","IsTransactional":false,"PropagateIngestionProperties":false},{"IsEnabled":true,"Source":"RdmTrustRaw","Query":"ParseActivations(ExpandTrustRdm())","IsTransactional":false,"PropagateIngestionProperties":false}]'

.alter table TrustCancellations policy update @'[{"IsEnabled":true,"Source":"RawFeed","Query":"ParseCancellations(ExpandTrustNrod())","IsTransactional":false,"PropagateIngestionProperties":false},{"IsEnabled":true,"Source":"RdmTrustRaw","Query":"ParseCancellations(ExpandTrustRdm())","IsTransactional":false,"PropagateIngestionProperties":false}]'

.alter table TrustOtherEvents policy update @'[{"IsEnabled":true,"Source":"RawFeed","Query":"ParseOtherTrust(ExpandTrustNrod())","IsTransactional":false,"PropagateIngestionProperties":false},{"IsEnabled":true,"Source":"RdmTrustRaw","Query":"ParseOtherTrust(ExpandTrustRdm())","IsTransactional":false,"PropagateIngestionProperties":false}]'

.alter table TdEvents policy update @'[{"IsEnabled":true,"Source":"RawFeed","Query":"ParseTd()","IsTransactional":false,"PropagateIngestionProperties":false}]'

.alter table RtppmNational policy update @'[{"IsEnabled":true,"Source":"RawFeed","Query":"ParseRtppm()","IsTransactional":false,"PropagateIngestionProperties":false}]'

.alter table DarwinLocations policy update @'[{"IsEnabled":true,"Source":"RdmTrustRaw","Query":"ParseDarwinLocations()","IsTransactional":false,"PropagateIngestionProperties":false}]'
