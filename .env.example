# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# ---------------------------------------------------------------------------
# Network Rail Open Data (NROD) - https://publicdatafeeds.networkrail.co.uk
NROD_USERNAME=you@example.com
NROD_PASSWORD=
NROD_HOST=publicdatafeeds.networkrail.co.uk
NROD_STOMP_PORT=61618
# Comma-separated topics, e.g. TRAIN_MVT_ALL_TOC,RTPPM_ALL,VSTP_ALL,TSR_ALL_ROUTE,TD_ALL_SIG_AREA
NROD_TOPICS=TRAIN_MVT_ALL_TOC
NROD_DURABLE=true
# Defaults to NROD_USERNAME. Only ONE process may use a given client-id at a time.
NROD_CLIENT_ID=
NROD_SUBSCRIPTION_PREFIX=rail-fabric-rti
NROD_HEARTBEAT_MS=15000
BACKOFF_INITIAL_S=1
BACKOFF_MAX_S=60

# Rail Data Marketplace (RDM) Kafka - typed into the Eventstream Apache Kafka source UI, not used by scripts
RDM_KAFKA_BOOTSTRAP_SERVERS=
RDM_KAFKA_TOPIC=
RDM_KAFKA_CONSUMER_GROUP=
RDM_KAFKA_USERNAME=
RDM_KAFKA_PASSWORD=

# Bridge behaviour ------------------------------------------------------------
# BRIDGE_SOURCE: stomp (live NROD) | replay (bundled fixtures, offline)
BRIDGE_SOURCE=stomp
# BRIDGE_SINK: console | file | eventstream
BRIDGE_SINK=console
BRIDGE_OUTPUT_FILE=./out/messages.jsonl
BRIDGE_SPLIT_BATCHES=true
REPLAY_FILE=tests/fixtures/replay_frames.json
HEALTH_PORT=8080
LOG_LEVEL=INFO

# Azure (Labs 01, 05b) ---------------------------------------------------------------
AZ_SUBSCRIPTION_ID=
AZ_RESOURCE_GROUP=rg-rail-fabric-rti
AZ_LOCATION=uksouth
NAME_PREFIX=railrti
# Leave empty to build into the ACR created by the template; or e.g. ghcr.io/<owner>/rail-fabric-rti-bridge:latest
CONTAINER_IMAGE=
BRIDGE_CPU=0.25
BRIDGE_MEMORY=0.5Gi
# Shared Key Vault (Lab 01 step 8, scripts/create-keyvault.*). Leave KEY_VAULT_NAME empty to use the generated name.
# Set it only if you created the vault by hand with a different name. KEY_VAULT_URL is used by the Lab 03 notebook.
KEY_VAULT_NAME=
KEY_VAULT_URL=

# Azure (Lab 02) ---------------------------------------------------------------

# Fabric Eventstream custom endpoint (Event Hub protocol, SAS key authentication)
# Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key-name>;SharedAccessKey=<key>;EntityPath=<entity>
EVENTSTREAM_CONNECTION_STRING=
# Only needed if your connection string has no EntityPath
EVENTSTREAM_ENTITY_NAME=

# Fabric (Labs 02, 03, 06) ------------------------------------------------------
FABRIC_CAPACITY_ID=
FABRIC_WORKSPACE_NAME=RailIntelligence
FABRIC_WORKSPACE_ID=
FABRIC_EVENTHOUSE_NAME=RailEventhouse
FABRIC_KQL_DATABASE_NAME=RailKQL
FABRIC_LAKEHOUSE_NAME=RailLakehouse
FABRIC_EVENTSTREAM_RDM_NAME=RailEventstreamRdm
FABRIC_EVENTSTREAM_NROD_NAME=RailEventstreamNrod

# Filled in from scripts/fabric-setup output or retrieved via Portal
FABRIC_WORKSPACE_ID=
FABRIC_EVENTHOUSE_ID=
FABRIC_KQL_DATABASE_ID=
FABRIC_LAKEHOUSE_ID=
# Query URI of the KQL database, e.g. https://<id>.<region>.kusto.fabric.microsoft.com
KUSTO_QUERY_URI=

# Azure (Lab 05b) ---------------------------------------------------------------
AZ_SUBSCRIPTION_ID=
AZ_RESOURCE_GROUP=rg-rail-fabric-rti
AZ_LOCATION=uksouth
NAME_PREFIX=railrti
# Leave empty to build into the ACR created by the template; or e.g. ghcr.io/<owner>/rail-fabric-rti-bridge:latest
CONTAINER_IMAGE=
BRIDGE_CPU=0.25
BRIDGE_MEMORY=0.5Gi

# Foundry (Lab 10) ----------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=
FABRIC_PROJECT_CONNECTION_ID=
FOUNDRY_AGENT_NAME=rail-network-agent
